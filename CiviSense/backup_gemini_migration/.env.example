# Copy to .env (never commit .env). Real environment variables override this file.

# --- Django ---
CIVISENSE_DEBUG=1
# REQUIRED when CIVISENSE_DEBUG=0. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
CIVISENSE_SECRET_KEY=

# --- PostgreSQL ---
CIVISENSE_DB_NAME=civisense
CIVISENSE_DB_USER=civisense
CIVISENSE_DB_PASSWORD=
CIVISENSE_DB_HOST=localhost
CIVISENSE_DB_PORT=5432

# --- AI assistant (Claude). Server-side only; never placed in HTML/JavaScript ---
ANTHROPIC_API_KEY=
CIVISENSE_CLAUDE_MODEL=claude-sonnet-5-5
CIVISENSE_ASSISTANT_MAX_TOKENS=1500
CIVISENSE_ASSISTANT_RATE=12

# --- MCP server ---
# Signs identity + approval tokens. Use a long random value; falls back to CIVISENSE_SECRET_KEY if empty.
CIVISENSE_MCP_SECRET=
